[Unit]
Description=Local Leet OJ (Ubuntu judge host)
After=network.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
Environment=LOCAL_LEET_ROOT=@ROOT@
Environment=PYTHONPATH=@ROOT@/backend
Environment=LOCAL_LEET_HOST=0.0.0.0
Environment=LOCAL_LEET_PORT=8080
ExecStart=@ROOT@/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
